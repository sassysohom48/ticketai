# ── Frontend (set in Vercel dashboard or .env.local) ──────────────────────
VITE_API_URL=https://ticketai-backend.onrender.com

# ── Backend (set on Render / Railway / locally) ───────────────────────────
PYTHONUNBUFFERED=1
JWT_SECRET=change-me-to-a-long-random-string

# Gmail SMTP — use an App Password (not your regular Gmail password)
# Steps: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Admin notification email (receives a copy of every new ticket)
ADMIN_EMAIL=sohom.m@somaiya.edu

# Optional: uncomment to enable HuggingFace BERT pipeline
# USE_ZERO_SHOT=true
