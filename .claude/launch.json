{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-u", "app.py"],
      "port": 5000,
      "cwd": "backend",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "FLASK_ENV": "development"
      }
    }
  ]
}
